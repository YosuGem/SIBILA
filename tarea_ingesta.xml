<?xml version="1.0" encoding="UTF-8"?>
<!-- SIBILA · tarea diaria de ingesta (plan Bloque 3 seccion 4).
     Placeholders que sustituye instalar.bat: {SIBILA_RAIZ} y {START_BOUNDARY}
     (maniana a las 07:00 hora local; el dia de datos es UTC interno).
     PLANTILLA en UTF-8; el XML final que consume schtasks se escribe en
     UTF-16 LE con BOM (D-077: en la prueba real W11, schtasks RECHAZO la
     variante UTF-8 sin BOM y acepto UTF-16 — lo que decia esta nota antes
     era una hipotesis sin probar). -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>SIBILA: ingesta diaria de fuentes (reddit, lobsters y mastodon por defecto)</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>{START_BOUNDARY}</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT5M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "{SIBILA_RAIZ}\ingesta_diaria.bat"</Arguments>
      <WorkingDirectory>{SIBILA_RAIZ}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
