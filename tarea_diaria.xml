<?xml version="1.0" encoding="UTF-8"?>
<!-- SIBILA · tarea diaria del pipeline completo (plan T2 seccion 6, D-048).
     Placeholders que sustituye instalar.bat: {SIBILA_RAIZ} y {START_BOUNDARY}
     (maniana a las 07:45 hora local; el dia de datos es UTC interno).
     ExecutionTimeLimit PT2H explicito (D-048/H6: un procesa acumulado de
     semanas no cabe en el PT1H de la ingesta).
     PLANTILLA en UTF-8; el XML final que consume schtasks se escribe en
     UTF-16 LE con BOM (D-077: verificado en la prueba real W11). -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>SIBILA: pipeline diario completo (ingesta, procesa, detecta, registro, digest)</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>{START_BOUNDARY}</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT5M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "{SIBILA_RAIZ}\pipeline_diario.bat"</Arguments>
      <WorkingDirectory>{SIBILA_RAIZ}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
